
<div style="background:#fff; padding:35px; border-radius:12px; box-shadow:0 8px 25px rgba(0,0,0,.15);">

<h2 style="color:green; text-align:center;">
    <% if flash[:alert] %>
      <p><%= flash[:alert] %></p>
    <% end %>
</h2>
  <h3 style="text-align: center; margin-bottom:20px;">
    <%= link_to "Book New Appointment", new_appointment_path, style: "color:#215a97; font-weight:400; background: #cfdeed; padding:20px; border-radius:25px;" %>
  </h3>

  <h1 style="text-align:center; color:#2c3e50; margin-bottom:30px;">
    Your Appointments
  </h1>

  <% if @appointments.present? %>

  <div style="display:flex; font-weight:bold; font-size:19px;">

    <div style="margin-right:20px;">
    <%= form_tag appointments_path, method: :get do %>
      <p>Filter Status</p>
      <select onChange="this.form.submit()" name="filter" style="background:#cfdeed;
       color:#215a97;border:none; padding:10px 18px; border-radius:6px; cursor:pointer; font-weight:bold;">
        <option value="">Status</option>
        <option value="scheduled">Scheduled</option>
        <option value="completed">Completed</option>
        <option value="canceled">Canceled</option>
      </select>
    <% end %>
    </div>

    <div>
    <%= form_tag appointments_path, method: :get do %>
      <p>Filder Dates</p>
      <select onChange="this.form.submit()" name="type" style="background:#cfdeed;
       color:#215a97;border:none; padding:10px 18px; border-radius:6px; cursor:pointer; font-weight:bold;">
        <option value="">Dates</option>
        <option value="today">Today's</option>
        <option value="upcoming">Upcoming</option>
        <option value="past">Past</option>
      </select>
    <% end %>
    </div>
  </div>

    <% @appointments.each do |a| %>

      <%= button_to appointment_show_path,
          params: { id: a.id },
          method: :post,
          style: "width:100%;
                  border:none;
                  background:none;
                  padding:0;
                  margin-bottom:20px;
                  cursor:pointer;
                  text-align:left;" do %>

        <div style="background:#fff;
                    border-left:6px solid <%= get_color_code(a.status) %>;
                    border-radius:12px;
                    padding:22px;
                    box-shadow:0 8px 20px rgba(0,0,0,.12);
                    transition:0.3s;">

          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">

            <h3 style="margin:0; color:#2c3e50;">
              Appointment
            </h3>

            <span style="background:<%= get_color_code(a.status) %>;
                        color:white;
                        padding:6px 14px;
                        border-radius:20px;
                        font-size:14px;
                        font-weight:bold;">
              <%= a.status.capitalize %>
            </span>

          </div>

          <hr style="border:none; border-top:1px solid #eee; margin-bottom:18px;">

          <p style="margin-bottom:12px; color:#555;">
            <strong>Date & Time:</strong><br>
            <%= a.appointment_at.strftime("%d %b %Y, %I:%M %p") %>
          </p>

          <p style="margin-bottom:12px; color:#555;">
            <strong>
              <%= current_user.is_a?(Doctor) ? "Patient" : "Doctor" %>:
            </strong><br>

            <% if current_user.is_a?(Doctor) %>
              <%= a.patient.name %>
            <% else %>
              Dr. <%= a.doctor.name %>
            <% end %>
          </p>

          <div style="margin-top:20px; text-align:right;">
            <span style="color:#007bff; font-weight:bold;">
              View Details →
            </span>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div style="text-align:center; padding:60px 20px;">
      <h2 style="color:#888;">
        No Appointments Found
      </h2>
    </div>
  <% end %>
</div>
