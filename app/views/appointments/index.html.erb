<div style="background:#fff; padding:35px; border-radius:12px; box-shadow:0 8px 25px rgba(0,0,0,.15);">

  <% if flash[:alert] %>
    <div style="background:#ffe5e5; color:#d63031; padding:12px; border-left:5px solid #dc3545; border-radius:6px; margin-bottom:25px; font-weight:bold;">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:35px; flex-wrap:wrap; gap:15px;">

    <h1 style="color:#2c3e50; margin:0;">
      Your Appointments
    </h1>

    <%= link_to "＋ Book New Appointment",
        new_appointment_path,
        style:"background:#007bff;
               color:white;
               text-decoration:none;
               padding:12px 22px;
               border-radius:8px;
               font-weight:bold;
               box-shadow:0 4px 10px rgba(0,123,255,.25);" %>

  </div>

  <% if @appointments.present? %>

    <div style="display:flex; gap:20px; margin-bottom:30px; flex-wrap:wrap;">

      <%= form_tag appointments_path, method: :get do %>

        <div>
          <label style="display:block; margin-bottom:8px; font-weight:bold; color:#2c3e50;">
            Filter By Status
          </label>

          <select name="filter"
                  onchange="this.form.submit()"
                  style="width:180px;
                         padding:10px;
                         border:1px solid #ccc;
                         border-radius:6px;
                         background:white;
                         font-size:15px;">

            <option value="">All Status</option>
            <option value="scheduled" <%= "selected" if params[:filter] == "scheduled" %>>
              Scheduled
            </option>
            <option value="completed" <%= "selected" if params[:filter] == "completed" %>>
              Completed
            </option>
            <option value="canceled" <%= "selected" if params[:filter] == "canceled" %>>
              Cancelled
            </option>

          </select>

        </div>

      <% end %>

      <%= form_tag appointments_path, method: :get do %>

        <div>

          <label style="display:block; margin-bottom:8px; font-weight:bold; color:#2c3e50;">
            Filter By Date
          </label>

          <select name="type"
                  onchange="this.form.submit()"
                  style="width:180px;
                         padding:10px;
                         border:1px solid #ccc;
                         border-radius:6px;
                         background:white;
                         font-size:15px;">

            <option value="">All Dates</option>
            <option value="today" <%= "selected" if params[:type] == "today" %>>
              Today
            </option>
            <option value="upcoming" <%= "selected" if params[:type] == "upcoming" %>>
              Upcoming
            </option>
            <option value="past" <%= "selected" if params[:type] == "past" %>>
              Past
            </option>

          </select>

        </div>

      <% end %>

    </div>

    <% @appointments.each do |a| %>

      <%= link_to appointment_path(a),
          style:"text-decoration:none; color:inherit;" do %>

        <div style="background:white;
                    border-left:6px solid <%= get_color_code(a.status) %>;
                    border-radius:12px;
                    padding:22px;
                    margin-bottom:20px;
                    box-shadow:0 6px 18px rgba(0,0,0,.12);
                    transition:.3s;">

          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">

            <h2 style="margin:0; color:#2c3e50; font-size:22px;">
              Appointment
            </h2>

            <span style="background:<%= get_color_code(a.status) %>;
                         color:white;
                         padding:6px 14px;
                         border-radius:20px;
                         font-size:13px;
                         font-weight:bold;">
              <%= a.status.capitalize %>
            </span>

          </div>

          <hr style="border:none; border-top:1px solid #ececec; margin-bottom:18px;">

          <div style="display:grid; grid-template-columns:170px auto; row-gap:14px;">

            <div style="font-weight:bold; color:#2c3e50;">
              Appointment Time
            </div>

            <div style="color:#555;">
              <%= a.appointment_at.strftime("%d %b %Y, %I:%M %p") %>
            </div>

            <div style="font-weight:bold; color:#2c3e50;">
              <%= current_user.is_a?(Doctor) ? "Patient" : "Doctor" %>
            </div>

            <div style="color:#555;">
              <% if current_user.is_a?(Doctor) %>
                <%= a.patient.name %>
              <% else %>
                Dr. <%= a.doctor.name %>
              <% end %>
            </div>

          </div>

          <div style="margin-top:22px; text-align:right;">

            <span style="display:inline-block;
                         background:#eef5ff;
                         color:#007bff;
                         padding:8px 16px;
                         border-radius:20px;
                         font-weight:bold;">

              View Details →

            </span>

          </div>

        </div>

      <% end %>

    <% end %>

  <% else %>

    <div style="text-align:center; padding:80px 20px;">

      <h2 style="color:#999; margin-bottom:10px;">
        No Appointments Found
      </h2>

      <p style="color:#666; margin-bottom:25px;">
        You don't have any appointments yet.
      </p>

      <%= link_to "Book Your First Appointment",
          new_appointment_path,
          style:"background:#007bff;
                 color:white;
                 text-decoration:none;
                 padding:12px 24px;
                 border-radius:8px;
                 font-weight:bold;" %>

    </div>

  <% end %>

</div>