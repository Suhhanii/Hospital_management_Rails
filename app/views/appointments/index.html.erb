<h1>Your Appointments</h1>
<% if current_user&.is_a?(Doctor) %>
  <% if @scheduled.present? || @canceled.present? || @completed.present? %>

    <% if @scheduled.present? %>
      <h3>Schedule Appointments </h3>
      <% @scheduled.each do |a| %>
        Appointment at : <%= a.appointment_at %>
        status is : <b><%= a.status %></b>
        with <%= Patient.find(a.patient_id).name %>
        <br>
      <% end %>
    <% end %>

    <% if @canceled.present? %>
      <h3> Cancel Appointments </h3>
      <% @canceled.each do |a| %>
         Appointment at : <%= a.appointment_at %>
         status is : <b><%= a.status %></b>
         with <%= Patient.find(a.patient_id).name %>
         <br>
      <% end %>
    <% end %>

    <% if @completed.present? %>
      <h3> Completed Appointments </h3>
      <% @completed.each do |a| %>
        Appointment at : <%= a.appointment_at %>
        status is : <b><%= a.status %></b>
        with <%= Patient.find(a.patient_id).name %>
        <br>
      <% end %>
    <% end %>

  <% else %>
     <h2> There is no Appointments </h2>
  <% end %>
<% else %>
  <h1>hello patient</h1>
<% end %>

<%#
@doc = Doctor.find(session[:user_id])
@a = @doc.appointments
@today_schedule_app = @a.todays_appointments("scheduled")
@today_cancel_app = @a.todays_appointments("canceled")
@today_completed_app = @a.todays_appointments("completed")
%>
