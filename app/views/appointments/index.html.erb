<h1>Your <%= @status %> Appointments</h1>
  <% if @scheduled.present? || @canceled.present? || @completed.present? %>

    <% if @scheduled.present? %>
      <h3>Schedule Appointments </h3>
      <% @scheduled.each do |a| %>
        <h3 class="appointment" style="border-style:solid; padding:10px;" onclick="updateappointment(this)" >
        Appointment at : <%= a.appointment_at %>
        status is : <b><%= a.status %></b>
        with 
        <% if current_user.is_a?(Doctor) %>
        <%= Patient.find(a.patient_id).name %>
        <%# <%= link_to "Complete", root_path %>
        <% else %>
        Dr.
        <%= Doctor.find(a.doctor_id).name %>
        <% end %>
        </h3>
      <% end %>
    <% end %>

    <% if @canceled.present? %>
      <h3> Cancel Appointments </h3>
      <% @canceled.each do |a| %>
        <h3>
         Appointment at : <%= a.appointment_at %>
         status is : <b><%= a.status %></b>
         with 
         <% if current_user.is_a?(Doctor) %>
         <%= Patient.find(a.patient_id).name %>
         <% else %>
         <%= Doctor.find(a.doctor_id).name %>
         <% end %>
         </h3>
         <br>
      <% end %>
    <% end %>

    <% if @completed.present? %>
      <h3> Completed Appointments </h3>
      <% @completed.each do |a| %>
        <h3>
        Appointment at : <%= a.appointment_at %>
        status is : <b><%= a.status %></b>
        with 
        <% if current_user.is_a?(Doctor) %>
        <%= Patient.find(a.patient_id).name %>
        <% else %>
        <%= Doctor.find(a.doctor_id).name %>
        <% end %>
        </h3>
        <br>
      <% end %>
    <% end %>

  <% else %>
     <h2> There is no Appointments </h2>
  <% end %>

<style>
.appointment:hover {
  background-color: lightyellow;
}

</style>

<script>
  function updateappointment(a)
  {
    console.log(a)
    console.log("hello")
  }
</script>
