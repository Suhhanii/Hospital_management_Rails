<% if current_user&.is_a?(Doctor) %>
  <center>
    <h1>Welcome Doctor, <%= current_user.name %> </h1>
  </center>

  <center>
    <h2>Today's Appointments </h2>
      <br>

      <h3>
        Scheduled : <%= @today_schedule_app.count %>
      </h3>

      <h3>
        Completed : <%= @today_completed_app.count %>
      </h3>

      <h3>
        Cancelled : <%= @today_cancel_app.count %>
      </h3>
  </center>
  <%# link_to "View Appointments", appointments_path %> 
<% else %>
  <center>
  <h1>Welcome, <%= current_user.name.capitalize %> </h1>
  </center>
<% end %>
