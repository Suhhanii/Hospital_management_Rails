<!DOCTYPE html>
<html>
  <head>
    <title>City Care Hospital</title>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css?family=Roboto:300,400,500,700|Roboto+Slab:400,700|Material+Icons" %>

    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <center>
    <header>
      <h1>Hospital Management System </h1>
      <% if session[:user_id] %>
        <%= form_with url: session_path(session[:user_id]), method: :delete do %>
          <%= submit_tag 'Logout' %>
        <% end %>

      <%# else %>
        <%#  link_to 'Login', new_session_path %>
      <% end %>
      
    </header>

    <% if notice %>
      <p><%= notice %></p>
    <% end %>
   
    <%= yield %>
    </center>
  </body>
</html>
