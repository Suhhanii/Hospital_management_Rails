<!DOCTYPE html>
<html>
  <head>
    <title>City Care Hospital</title>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css?family=Roboto:300,400,500,700|Roboto+Slab:400,700|Material+Icons" %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= csrf_meta_tags %> <!-- 👈 MAKE SURE THIS LINE IS HERE -->
    <%= csp_meta_tag %>  
  <style>
    html, body{
      width:100%;
      height:100%;
      margin:0;
      padding:0;
    }

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial,sans-serif;
    }

    body{
      background:#f4f7fb;
    }

    .layout{
    display:flex;
    min-height:100vh;
    width:100%;
    }

    aside{
      width:250px;
      background:linear-gradient(30deg,#7ddbd2,#648eb3);
      color:white;
      padding:25px 15px;
    }

    aside h2{
      text-align:center;
      margin-bottom:30px;
    }

    aside a{
      display:block;
      text-decoration:none;
      color:white;
      padding:12px 15px;
      margin-top:12px;
      border-radius:8px;
      transition:.3s;
    }

    aside a:hover{
      background:white;
      color:#007bff;
    }

    .submenu{
      display:none;
      margin-left:10px;
      margin-top:8px;
    }

    .submenu a{
      margin-top:6px;
      background:rgba(255,255,255,.12);
      font-size:14px;
    }

    .submenu a:hover{
      background:white;
      color:#007bff;
    }

    main{
      flex:1;
      padding:30px;
    }

    .top-bar{
      display:flex;
      justify-content:space-between;
      margin-bottom:25px;
    }

    .logout-btn{
      background:#dc3545;
      color:white;
      border:none;
      padding:10px 18px;
      border-radius:6px;
      cursor:pointer;
      font-weight:bold;
    }

    .login-btn{
      text-decoration:none;
      background:#007bff;
      color:white;
      padding:10px 18px;
      border-radius:6px;
      font-weight:bold;
    }

    .dashboard-card{
      background:white;
      border-radius:12px;
      box-shadow:0 8px 25px rgba(0,0,0,.15);
      padding:35px;
    }
    .navigation-bar {
      margin-bottom: 15px;
      display: flex;
    }

    .back-btn {
      background:#cfdeed;
      color:#215a97;
    }

  </style>
  </head>
<body>
  <div class="layout">
    <aside>

      <h2>City Care</h2>

      <%= link_to "Profile", user_path(current_user) if current_user %>
      <%= link_to "Dashboard",
          root_path %>
      <%= link_to "Appointments",
          appointments_path %>
      <% if current_user.is_a?(Doctor) %>
        <%= link_to "Working Hours", working_hours_path %>
        <%= link_to "Specializations", specializations_path %>
      <% else %>
        <%= link_to "Doctors", doctors_path %>
      <% end %>
    </aside>
    <main>
      <div class="top-bar">

        <div class="navigation-bar">
          <%= link_to "Back", request.referer, class: "logout-btn back-btn" %>
        </div>

        <% if cookies.encrypted[:user_id] %>
          <%= form_with url: session_path(cookies.encrypted[:user_id]), method: :delete do %>
            <%= submit_tag "Logout", class:"logout-btn" %>
          <% end %>
        <% else %>
          <%= link_to "Login", new_session_path, class:"login-btn" %>
        <% end %>
      </div>
      <div class="dashboard-card">
        <%= yield %>
      </div>
    </main>
  </div>
  <script>
    function toggleAppointments() {
      let menu = document.getElementById("appointmentMenu");

      if (menu.style.display === "block") {
        menu.style.display = "none";
      } else {
        menu.style.display = "block";
      }
    }
  </script>
</body>
</html>
