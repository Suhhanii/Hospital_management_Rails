<!DOCTYPE html>
<html>
<head>
  <title>City Care Hospital</title>

  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial,sans-serif;
    }

    body{
      background:#f4f7fb;
    }

    .container{
      display:flex;
      min-height:100vh;
    }

    aside{
      width:250px;
      background:linear-gradient(30deg,#0048bd,#44a7fd);
      color:white;
      padding:25px 15px;
    }

    aside h2{
      text-align:center;
      margin-bottom:30px;
    }

    aside a{
      display:block;
      text-decoration:none;
      color:white;
      padding:12px 15px;
      margin-top:12px;
      border-radius:8px;
      transition:.3s;
    }

    aside a:hover{
      background:white;
      color:#007bff;
    }

    .submenu{
      display:none;
      margin-left:10px;
      margin-top:8px;
    }

    .submenu a{
      margin-top:6px;
      background:rgba(255,255,255,.12);
      font-size:14px;
    }

    .submenu a:hover{
      background:white;
      color:#007bff;
    }

    main{
      flex:1;
      padding:30px;
    }

    .top-bar{
      display:flex;
      justify-content:flex-end;
      margin-bottom:25px;
    }

    .logout-btn{
      background:#dc3545;
      color:white;
      border:none;
      padding:10px 18px;
      border-radius:6px;
      cursor:pointer;
      font-weight:bold;
    }

    .login-btn{
      text-decoration:none;
      background:#007bff;
      color:white;
      padding:10px 18px;
      border-radius:6px;
      font-weight:bold;
    }

    .dashboard-card{
      background:white;
      border-radius:12px;
      box-shadow:0 8px 25px rgba(0,0,0,.15);
      padding:35px;
    }
  </style>
</head>

<body>

<div class="container">

  <aside>

    <h2>City Care</h2>

    <%= link_to "Profile", user_path(current_user) %>

    <!-- Appointment Menu -->
    <a href="#" onclick="toggleAppointments(); return false;">
      Show Appointments ▼
    </a>

    <div id="appointmentMenu" class="submenu">

      <%= link_to "Today's Appointments",
          appointments_path(filter: "today") %>

      <%= link_to "Upcoming Appointments",
          appointments_path(filter: "upcoming") %>

      <%= link_to "Past Appointments",
          appointments_path(filter: "past") %>

    </div>

    <% if current_user.is_a?(Doctor) %>

      <%= link_to "Working Hours", working_hours_path %>

      <%= link_to "Specializations", specializations_path %>

    <% else %>

      <%= link_to "Doctors", doctors_path %>

    <% end %>

  </aside>

  <main>

    <div class="top-bar">

      <% if session[:user_id] %>

        <%= form_with url: session_path(session[:user_id]), method: :delete do %>
          <%= submit_tag "Logout", class:"logout-btn" %>
        <% end %>

      <% else %>

        <%= link_to "Login", new_session_path, class:"login-btn" %>

      <% end %>

    </div>

    <div class="dashboard-card">

      <%= yield %>

    </div>

  </main>

</div>

<script>
  function toggleAppointments() {
    let menu = document.getElementById("appointmentMenu");

    if (menu.style.display === "block") {
      menu.style.display = "none";
    } else {
      menu.style.display = "block";
    }
  }
</script>

</body>
</html>
