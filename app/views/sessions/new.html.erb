<div class="text-center">
  <h1>Sign In</h1>

  <% if flash[:alert] %>
    <p style="color:red;" ><%= flash[:alert] %></p>
  <% end %>

  <%= form_with(model: @user, url: sessions_path, local: true) do |f| %>

    <div class="row">
      <%= f.label :email %><br>
      <%= f.email_field :email, placeholder: "Enter your email" %>
    </div>

    <div class="row">
      <%= f.label :password %><br>
      <%= f.password_field :password, placeholder: "Enter your password" %>
    </div>

    <div class="row">
      <%= f.submit "Sign In" %>
    </div>

  <% end %>
  <br>
  <h3>New User ? <%= link_to 'Sign-up', new_user_path %> </h3>
</div>
