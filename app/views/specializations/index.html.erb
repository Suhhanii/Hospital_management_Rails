<div style="background:#fff; padding:35px; border-radius:12px; box-shadow:0 8px 25px rgba(0,0,0,.15); max-width:700px; margin:auto;">

  <h1 style="text-align:center; color:#2c3e50; margin-bottom:30px;">
    <%= current_user.name.capitalize %>'s Specialization
  </h1>

  <div style="padding:20px; background:#f8f9fa; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,.08);">

    <h3 style="color:#34495e; margin-bottom:10px;">
      Specialization
    </h3>

    <p style="font-size:20px; color:#007bff; font-weight:bold; margin:0;">
      <%= current_user.specialization.name %>
    </p>

  </div>

</div>