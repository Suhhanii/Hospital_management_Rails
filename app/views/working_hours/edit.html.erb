<h1>WorkingHours</h1>
<%= form_with(model: @working_hour, url: working_hour_path(@working_hour)) do |t| %>

<div>
  <%= t.label :day_of_week %>
  <%= t.text_field :day_of_week %>
</div>

<div>
  <%= t.label :start_time %>
  <%= t.text_field :start_time %>
</div>

<div>
  <%= t.label :end_time %>
  <%= t.text_field :end_time %>
</div>

<%= t.submit "Update" %>
<% end %>
