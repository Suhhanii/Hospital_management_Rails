<div style="background:#fff; padding:35px; border-radius:12px; box-shadow:0 8px 25px rgba(0,0,0,.15); max-width:800px; margin:auto;">

  <h1 style="text-align:center; color:#2c3e50; margin-bottom:30px;">
    <%= current_user.name.capitalize %>'s Working Hours
  </h1>

  <% if @working_hours.present? %>

    <% @working_hours.each do |wh| %>
     <%= link_to working_hour_path(wh.id), style: "text-decoration:none; color:inherit;" do %>
      <div style="background:#f8f9fa; padding:20px; margin-bottom:18px; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,.08);">

        <h2 style="color:#007bff; margin-bottom:12px;">
          <%= wh.day_of_week.capitalize %>
        </h2>

        <p style="font-size:17px; margin:8px 0;">
          <strong>Start Time:</strong>
          <%= wh.start_time.strftime("%I:%M %p") %>
        </p>

        <p style="font-size:17px; margin:8px 0;">
          <strong>End Time:</strong>
          <%= wh.end_time.strftime("%I:%M %p") %>
        </p>

      </div>
     <% end %>
    <% end %>

  <% else %>

    <div style="text-align:center; padding:40px;">
      <h2 style="color:#888;">No Working Hours Available</h2>
    </div>

  <% end %>

</div>
